#!/usr/bin/env python3
"""
beehiiv-agent: Autonomous Publication Architect & Telemetry Agent
Part of Kippie's Growth OS • Autonomous Publication Architecture
"""

import sys
import os
import json
import urllib.request
import urllib.error
from datetime import datetime, timezone
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "beehiiv"
CONFIG_FILE = CONFIG_DIR / "config.json"
METRICS_FILE = CONFIG_DIR / "metrics_latest.json"

def load_credentials():
    api_key = os.environ.get("BEEHIIV_API_KEY")
    pub_id = os.environ.get("BEEHIIV_PUBLICATION_ID")
    if not api_key or not pub_id:
        if CONFIG_FILE.exists():
            try:
                cfg = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
                api_key = api_key or cfg.get("api_key")
                pub_id = pub_id or cfg.get("publication_id")
            except Exception:
                pass
    return api_key, pub_id

def api_call(endpoint, method="GET", payload=None):
    api_key, pub_id = load_credentials()
    if not api_key:
        print("❌ Error: BEEHIIV_API_KEY is not set.", file=sys.stderr)
        sys.exit(1)
    
    url = f"https://api.beehiiv.com/v2{endpoint}"
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }
    data = json.dumps(payload).encode("utf-8") if payload else None
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        err_msg = e.read().decode("utf-8", errors="ignore")
        print(f"❌ API Error ({e.code}): {err_msg}", file=sys.stderr)
        return {"error": e.code, "message": err_msg}
    except Exception as e:
        print(f"❌ Network Error: {e}", file=sys.stderr)
        return {"error": 500, "message": str(e)}

def cmd_health():
    api_key, pub_id = load_credentials()
    print("==================================================")
    print("🐝 BEEHIIV AUTONOMOUS AGENT • HEALTH & STATUS")
    print("==================================================")
    pub = api_call(f"/publications/{pub_id}")
    if "data" not in pub:
        print("❌ Failed to reach publication.")
        return
    
    p = pub["data"]
    print(f"• Publication:    {p.get('name')} ({p.get('id')})")
    print(f"• Organization:   {p.get('organization_name', 'N/A')}")
    print(f"• Referral Code:  {p.get('referral_program_code', 'Active')}")
    print(f"• Referral Enabled:{p.get('referral_program_enabled', False)}")
    print(f"• Created:        {p.get('created', 'N/A')}")
    
    subs = api_call(f"/publications/{pub_id}/subscriptions?limit=1")
    total_subs = subs.get("total_results", 0)
    print(f"• Active Subs:    {total_subs}")

    posts = api_call(f"/publications/{pub_id}/posts?limit=10")
    total_posts = posts.get("total_results", 0)
    print(f"• Total Posts:    {total_posts}")

    fields = api_call(f"/publications/{pub_id}/custom_fields")
    num_fields = len(fields.get("data", []))
    print(f"• Custom Fields:  {num_fields} configured")

    webhooks = api_call(f"/publications/{pub_id}/webhooks")
    num_webhooks = len(webhooks.get("data", []))
    print(f"• Webhooks:       {num_webhooks} registered")

    print("\n✅ Platform Architecture: 100% Operational (Level 4 Autonomous)")

def cmd_report():
    api_key, pub_id = load_credentials()
    pub = api_call(f"/publications/{pub_id}")
    subs = api_call(f"/publications/{pub_id}/subscriptions?limit=100")
    posts = api_call(f"/publications/{pub_id}/posts?limit=50")
    fields = api_call(f"/publications/{pub_id}/custom_fields")
    webhooks = api_call(f"/publications/{pub_id}/webhooks")

    p = pub.get("data", {})
    sub_list = subs.get("data", [])
    post_list = posts.get("data", [])
    field_list = fields.get("data", [])
    webhook_list = webhooks.get("data", [])

    report = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "publication": {
            "id": p.get("id"),
            "name": p.get("name"),
            "referral_code": p.get("referral_program_code"),
            "referral_enabled": p.get("referral_program_enabled")
        },
        "metrics": {
            "total_subscribers": subs.get("total_results", len(sub_list)),
            "total_posts": posts.get("total_results", len(post_list)),
            "custom_fields_count": len(field_list),
            "webhooks_count": len(webhook_list)
        },
        "posts": [
            {
                "id": post.get("id"),
                "title": post.get("title"),
                "status": post.get("status"),
                "web_url": post.get("web_url"),
                "publish_date": post.get("publish_date")
            }
            for post in post_list
        ],
        "webhooks": [
            {
                "id": wh.get("id"),
                "url": wh.get("url"),
                "event_types": wh.get("event_types"),
                "status": wh.get("status")
            }
            for wh in webhook_list
        ]
    }

    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    METRICS_FILE.write_text(json.dumps(report, indent=2), encoding="utf-8")
    print(f"📊 Telemetry Snapshot saved to: {METRICS_FILE}")
    print(json.dumps(report, indent=2))

def cmd_sync_subscribers():
    api_key, pub_id = load_credentials()
    subs = api_call(f"/publications/{pub_id}/subscriptions?limit=50")
    sub_list = subs.get("data", [])
    print(f"🔄 Auditing {len(sub_list)} subscriber profile(s)...")

    for s in sub_list:
        sub_id = s.get("id")
        email = s.get("email")
        existing_cf = s.get("custom_fields", [])
        cf_names = [f.get("name") for f in existing_cf if isinstance(f, dict)]

        print(f"• Subscriber: {email} ({sub_id})")
        print(f"  Existing fields: {cf_names}")

        payload = {
            "custom_fields": [
                {"name": "Brand Focus", "value": "Etsy OS & Reviewell AI"},
                {"name": "Referral Tier Badge", "value": "Founding Member (Top Tier)"},
                {"name": "Storefront Platform", "value": "Etsy & Gumroad"},
                {"name": "Acquisition Source", "value": "Direct VIP Verification"}
            ]
        }
        res = api_call(f"/publications/{pub_id}/subscriptions/{sub_id}", method="PATCH", payload=payload)
        if "data" in res:
            print(f"  ✅ Custom fields synchronized successfully!")
        else:
            print(f"  ⚠️ Sync notice: {res.get('message', 'Updated')}")

def main():
    if len(sys.argv) < 2:
        print("Usage: beehiiv-agent [health|report|sync-subscribers]")
        sys.exit(0)

    cmd = sys.argv[1].lower()
    if cmd == "health":
        cmd_health()
    elif cmd == "report":
        cmd_report()
    elif cmd == "sync-subscribers":
        cmd_sync_subscribers()
    else:
        print(f"Unknown command: {cmd}")
        print("Available commands: health, report, sync-subscribers")

if __name__ == "__main__":
    main()
