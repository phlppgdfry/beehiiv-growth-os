#!/usr/bin/env python3
"""
beehiiv CLI & MCP Bridge (Production Enterprise Edition)
Unified CLI tool for beehiiv Newsletter Platform API v2, MCP Connectors,
Connected Apps Badges & Certification Auditing, and Growth Automation.
"""

import sys
import os
import json
import argparse
import urllib.request
import urllib.error
from pathlib import Path
from typing import Optional, Dict, Any, List

CONFIG_DIR = Path.home() / ".config" / "beehiiv"
CONFIG_FILE = CONFIG_DIR / "config.json"
BASE_URL = "https://api.beehiiv.com/v2"
MCP_URL = "https://mcp.beehiiv.com"


def load_config() -> Dict[str, Any]:
    """Loads configuration from environment, ~/.config/beehiiv/config.json, or ~/.zshrc."""
    config: Dict[str, Any] = {
        "api_key": os.getenv("BEEHIIV_API_KEY", ""),
        "publication_id": os.getenv("BEEHIIV_PUBLICATION_ID", ""),
        "mcp_url": MCP_URL,
    }

    if CONFIG_FILE.exists():
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                saved = json.load(f)
                if not config["api_key"] and saved.get("api_key"):
                    config["api_key"] = saved["api_key"]
                if not config["publication_id"] and saved.get("publication_id"):
                    config["publication_id"] = saved["publication_id"]
        except Exception:
            pass

    if not config["api_key"]:
        zshrc = Path.home() / ".zshrc"
        if zshrc.exists():
            try:
                for line in zshrc.read_text(encoding="utf-8").splitlines():
                    if line.startswith("export BEEHIIV_API_KEY="):
                        config["api_key"] = line.split("=", 1)[1].strip().strip('"').strip("'")
                    elif line.startswith("export BEEHIIV_PUBLICATION_ID="):
                        config["publication_id"] = line.split("=", 1)[1].strip().strip('"').strip("'")
            except Exception:
                pass

    return config


def save_config(api_key: str, publication_id: str) -> None:
    """Saves API key and publication ID to config file."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    payload = {
        "api_key": api_key.strip(),
        "publication_id": publication_id.strip(),
        "mcp_url": MCP_URL,
    }
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(payload, f, indent=2)
    print(f"✅ Configuration successfully saved to: {CONFIG_FILE}")


def api_request(endpoint: str, method: str = "GET", data: Optional[Dict[str, Any]] = None, config: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    """Executes a request to beehiiv API v2."""
    if not config:
        config = load_config()

    api_key = config.get("api_key")
    if not api_key:
        raise ValueError("Missing BEEHIIV_API_KEY. Configure it via `beehiiv auth --key <KEY>` or set BEEHIIV_API_KEY in ~/.zshrc.")

    url = f"{BASE_URL}{endpoint}"
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
        "User-Agent": "beehiiv-cli/2.0.0 (Mac; AI-Growth-Engine)",
    }

    req_data = json.dumps(data).encode("utf-8") if data else None
    req = urllib.request.Request(url, data=req_data, headers=headers, method=method)

    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            body = resp.read().decode("utf-8")
            return json.loads(body) if body else {"status": resp.status}
    except urllib.error.HTTPError as e:
        error_msg = e.read().decode("utf-8")
        try:
            err_json = json.loads(error_msg)
            return {"error": True, "status_code": e.code, "details": err_json}
        except Exception:
            return {"error": True, "status_code": e.code, "message": error_msg}
    except Exception as e:
        return {"error": True, "message": str(e)}


def cmd_status(args: argparse.Namespace) -> None:
    """Shows beehiiv connection, credentials, and live publication statistics."""
    cfg = load_config()
    print("=" * 68)
    print("🐝 BEEHIIV PLATFORM, MCP & LIVE API v2 STATUS REPORT")
    print("=" * 68)
    
    api_key_masked = f"{cfg['api_key'][:6]}...{cfg['api_key'][-4:]}" if len(cfg['api_key']) > 10 else ("Configured" if cfg['api_key'] else "❌ Missing")
    pub_id = cfg.get("publication_id") or "❌ Missing"
    
    print(f"API Key:             {api_key_masked}")
    print(f"Publication ID:      {pub_id}")
    print(f"MCP Server Endpoint: {MCP_URL}")
    print(f"Config File:         {CONFIG_FILE}")
    print("-" * 68)

    if not cfg["api_key"]:
        print("\n⚠️  No API key configured.")
        print("To connect your beehiiv account:")
        print("  Run: beehiiv auth --key <YOUR_API_KEY> [--publication-id <PUB_ID>]")
        return

    print("\n🔍 Querying live beehiiv publication statistics...")
    res = api_request(f"/publications/{pub_id}?expand=stats", config=cfg)
    if res.get("error"):
        print(f"❌ Connection failed: Status {res.get('status_code', 'Unknown')}")
        print(f"Details: {res.get('details') or res.get('message')}")
    else:
        pub = res.get("data", {})
        stats = pub.get("stats", {})
        print(f"✅ Publication Name:     {pub.get('name')}")
        print(f"🏢 Organization:         {pub.get('organization_name')}")
        print(f"🎁 Referral Program:     {'ENABLED ✅' if pub.get('referral_program_enabled') else 'DISABLED ❌'}")
        print(f"👥 Active Subscribers:   {stats.get('active_subscriptions', 0)}")
        print(f"⭐ Premium Subscribers:  {stats.get('active_premium_subscriptions', 0)}")
        print(f"📧 Average Open Rate:    {stats.get('average_open_rate', 0.0)}%")
        print(f"🎯 Average Click Rate:   {stats.get('average_click_rate', 0.0)}%")
        print(f"📬 Total Emails Sent:    {stats.get('total_sent', 0)}")


def cmd_auth(args: argparse.Namespace) -> None:
    """Configures beehiiv API credentials."""
    key = args.key
    pub_id = args.publication_id or "pub_1d6adc05-2c3c-41ab-ab8e-08a535ad5ad1"
    if not key:
        print("Error: --key is required. Example: beehiiv auth --key <API_KEY>")
        sys.exit(1)
    save_config(key, pub_id)


def cmd_posts(args: argparse.Namespace) -> None:
    """Lists posts in publication."""
    cfg = load_config()
    pub_id = cfg.get("publication_id")
    res = api_request(f"/publications/{pub_id}/posts?status=all", config=cfg)
    if res.get("error"):
        print(f"❌ Error fetching posts: {res}")
        return

    posts = res.get("data", [])
    print(f"\n📑 Found {len(posts)} post(s) in publication {pub_id}:")
    print("-" * 68)
    for p in posts:
        status_badge = f"[{p.get('status', 'draft').upper()}]"
        print(f"• {status_badge:8} {p.get('title')}")
        print(f"  ID:      {p.get('id')}")
        print(f"  Preview: {p.get('preview_url')}")
        print(f"  Web:     {p.get('web_url')}")
        print(f"  Tags:    {', '.join(p.get('content_tags', []))}\n")


def cmd_subscribers(args: argparse.Namespace) -> None:
    """Lists subscribers in publication."""
    cfg = load_config()
    pub_id = cfg.get("publication_id")
    res = api_request(f"/publications/{pub_id}/subscriptions?limit=20", config=cfg)
    if res.get("error"):
        print(f"❌ Error fetching subscribers: {res}")
        return

    subs = res.get("data", [])
    print(f"\n👥 Subscribers in publication ({len(subs)} found):")
    print("-" * 68)
    for s in subs:
        print(f"• {s.get('email')} | Tier: {s.get('subscription_tier')} | Status: {s.get('status')} | Referral: {s.get('referral_code')}")


def cmd_custom_fields(args: argparse.Namespace) -> None:
    """Lists custom fields."""
    cfg = load_config()
    pub_id = cfg.get("publication_id")
    res = api_request(f"/publications/{pub_id}/custom_fields", config=cfg)
    if res.get("error"):
        print(f"❌ Error fetching custom fields: {res}")
        return

    fields = res.get("data", [])
    print(f"\n🏷️  Custom Fields in publication ({len(fields)} found):")
    print("-" * 68)
    for f in fields:
        print(f"• {f.get('display'):25} | Kind: {f.get('kind'):8} | ID: {f.get('id')}")


