def cmd_mcp(args: argparse.Namespace) -> None:
    """Displays MCP configuration for Claude, Codex, Cursor, and Antigravity."""
    cfg = load_config()
    print("=" * 68)
    print("🤖 BEEHIIV MODEL CONTEXT PROTOCOL (MCP) INTEGRATION GUIDE")
    print("=" * 68)
    print("Official Endpoint: https://mcp.beehiiv.com")
    print(f"Publication ID:    {cfg.get('publication_id')}")
    print("\nConfiguration snippet for Claude Desktop / Codex / Antigravity:")
    snippet = {
        "mcpServers": {
            "beehiiv": {
                "url": "https://mcp.beehiiv.com",
                "headers": {
                    "Authorization": f"Bearer {cfg.get('api_key')}"
                }
            }
        }
    }
    print(json.dumps(snippet, indent=2))
    print("=" * 68)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="beehiiv Platform Enterprise CLI, MCP Connector & Growth Engine",
        formatter_class=argparse.RawTextHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="command", help="Available subcommands")

    # status
    p_status = subparsers.add_parser("status", help="Check API connection, credentials, and publication stats")
    p_status.set_defaults(func=cmd_status)

    # auth
    p_auth = subparsers.add_parser("auth", help="Configure beehiiv API credentials")
    p_auth.add_argument("--key", required=True, help="beehiiv API v2 Bearer Token")
    p_auth.add_argument("--publication-id", help="Default publication ID")
    p_auth.set_defaults(func=cmd_auth)

    # posts
    p_posts = subparsers.add_parser("posts", help="List and inspect posts")
    p_posts.set_defaults(func=cmd_posts)

    # subscribers
    p_subs = subparsers.add_parser("subscribers", help="List and inspect subscribers")
    p_subs.set_defaults(func=cmd_subscribers)

    # custom fields
    p_cf = subparsers.add_parser("custom-fields", help="List custom fields")
    p_cf.set_defaults(func=cmd_custom_fields)

    # badges
    p_badges = subparsers.add_parser("badges", help="Inspect all partner badges, referral milestones & connected app tiers")
    p_badges.set_defaults(func=cmd_badges)

    # mcp
    p_mcp = subparsers.add_parser("mcp", help="Show Model Context Protocol setup and schema")
    p_mcp.set_defaults(func=cmd_mcp)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(0)

    args.func(args)


if __name__ == "__main__":
    main()
